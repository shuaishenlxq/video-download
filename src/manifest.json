{
  "manifest_version": 3,
  "name": "媒探 MediaSniff",
  "short_name": "媒探",
  "version": "1.0.0",
  "description": "装完即用的网页视频嗅探与下载：直下 / HLS / DASH 合并全在浏览器内完成，无付费墙，全程本地处理。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/idle16.png",
    "32": "icons/idle32.png",
    "48": "icons/idle48.png",
    "128": "icons/idle128.png"
  },
  "action": {
    "default_title": "媒探 MediaSniff",
    "default_icon": {
      "16": "icons/gray16.png",
      "32": "icons/gray32.png",
      "48": "icons/gray48.png",
      "128": "icons/gray128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/popup/index.html",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "nativeMessaging",
    "notifications",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "side_panel": {
    "default_path": "src/popup/index.html"
  }
}