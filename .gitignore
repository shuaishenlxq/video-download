*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# tsc 增量构建缓存
*.tsbuildinfo
.eslintcache

# ===== 测试覆盖 =====
coverage/

# ===== 编辑器 / IDE =====
.vscode/
.idea/

