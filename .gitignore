# ===== 依赖 & 构建产物 =====
node_modules/
# Vite 构建输出
dist/
# web-ext 打包产物（若用）
web-ext-artifacts/

# ===== 打包 / 发布物（含密钥，绝不入库） =====
*.zip
# 已打包的扩展（内嵌私钥）
*.crx

# ===== 密钥 / 环境 / 凭据（红线，绝不入库） =====
