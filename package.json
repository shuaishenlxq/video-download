{
  "name": "mediasniff",
  "private": true,
  "version": "1.0.0",
  "description": "MediaSniff（媒探）- 装完即用的网页视频嗅探与下载扩展",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
